# CASA AIRA BOUTIQUE - Environment Configuration Template
# Copy this file to .env.local and configure your actual values

# Application General
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Casa Aira Boutique"

# JWT Session Authentication
JWT_SECRET=casa_aira_admin_secure_secret_key_change_me

# Turso Database (LibSQL Edge Database)
TURSO_CONNECTION_URL=your-turso-db-url-here
TURSO_AUTH_TOKEN=your-turso-auth-token-here

# Cloudinary Integration (Image Upload & CDN)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Flow.cl Integration (Chile Native Payments: Webpay, Débito, Crédito, MACH)
FLOW_API_KEY=your-flow-api-key-here
FLOW_SECRET_KEY=your-flow-secret-key-here
FLOW_ENV=production

# Contact & Social Media Config (Optional defaults)
NEXT_PUBLIC_SUPPORT_EMAIL=contacto@kuyenchile.cl
NEXT_PUBLIC_PHONE_NUMBER="+56 9 8535 0038"
NEXT_PUBLIC_WHATSAPP_NUMBER=56985350038
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/casaaira_oficial
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/casaaira.oficial
NEXT_PUBLIC_TIKTOK_URL=https://tiktok.com/@casaaira_oficial
